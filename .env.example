# Copy this file to .env and fill in both values to enable real Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
T04_TRAP=0
MIN_TEST_ROC_AUC=0.90

# Optional: generate a persistent Fernet key for Airflow variable encryption.
# Leave empty for a local tutorial setup; don't use an empty key for deployment.
AIRFLOW_FERNET_KEY=

# Local MLflow / S3-compatible storage development credentials.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
S3_STORAGE_IMAGE=docker.io/pgsty/silo:RELEASE.2026-09-16T00-00-00Z
MLFLOW_DB_PASSWORD=mlflow-local
